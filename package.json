{
  "name": "avmirror-stremio-addon",
  "version": "26.1.0",
  "private": true,
  "description": "AVMirror Stremio addon using Playwright to render an authorized source and observe its network requests.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:local": "LOCAL_MODE=true node server.js",
    "dev": "node --watch server.js",
    "browser": "npx playwright install chromium",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "playwright": "1.55.1",
    "stremio-addon-sdk": "^1.6.10"
  }
}
